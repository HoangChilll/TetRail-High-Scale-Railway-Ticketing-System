# Local development examples only. Change these in your own .env.
APP_PORT=8080
LOCAL_POSTGRES_PORT=15432
LOCAL_REDIS_PORT=16379
POSTGRES_DB=tetrail
POSTGRES_USER=tetrail
POSTGRES_PASSWORD=tetrail_local_password
REDIS_PASSWORD=tetrail_local_redis_password
# Base64 of a 32-byte development key. Generate your own using the README.
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Optional integrations: configure real services to send notifications.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=noreply@tetrail.local
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
TELEGRAM_BOT_TOKEN=unused-in-this-lab
